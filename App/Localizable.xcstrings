        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TikTok: Pilote envía un borrador a la bandeja de TikTok 15 min antes de la hora; Sacha lo publica desde la app (descripción para pegar)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TikTok : Pilote envoie un brouillon dans la boîte TikTok 15 min avant l'heure ; Sacha le publie depuis l'app (légende à coller)"
          }
        }
      }
    },
