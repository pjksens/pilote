    },
    "Le mail part tel quel, maintenant, depuis votre Gmail, en texte simple et sans signature ajoutée. S'il existe aussi en brouillon dans Gmail, supprimez ce brouillon après l'envoi." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The email goes out as is, right now, from your Gmail, as plain text with no signature added. If it also exists as a draft in Gmail, delete that draft after sending."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El correo sale tal cual, ahora, desde tu Gmail, en texto simple y sin firma añadida. Si también existe como borrador en Gmail, elimina ese borrador después de enviarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mail part tel quel, maintenant, depuis votre Gmail, en texte simple et sans signature ajoutée. S'il existe aussi en brouillon dans Gmail, supprimez ce brouillon après l'envoi."
          }
        }
      }
    },
    "Le message est annulé. La fiche ne bouge pas : la ligne du jour reste pour décider de la suite." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
