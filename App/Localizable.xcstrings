    "Objectif : %@. Compte : un rappel non coché de demain dans « %@ » dont le titre ou le « But : » parle d'appel, relance, envoi, mail, DM, devis, facture, client…" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goal: %@. Counts: an unchecked reminder for tomorrow in “%@” whose title or “Goal:” line mentions a call, follow-up, send, email, DM, quote, invoice, client…"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objetivo: %@. Cuenta: un recordatorio sin marcar de mañana en «%@» cuyo título o línea «Objetivo:» habla de llamada, seguimiento, envío, correo, DM, presupuesto, factura, cliente…"
          }
        },
        "fr" : {
          "stringUnit" : {
