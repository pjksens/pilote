        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube : la vidéo part tout de suite en privé et YouTube la publie seul à l'heure, Mac éteint compris."
          }
        }
      }
    },
    "YouTube : miniature posée après le traitement de la vidéo ; si la chaîne n'a pas le droit aux miniatures personnalisées, YouTube garde la sienne (Pilote prévient)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube: thumbnail set after the video is processed; if the channel is not allowed custom thumbnails, YouTube keeps its own (Pilote will tell you)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube: la miniatura se pone cuando termina el procesamiento del vídeo; si el canal no puede tener miniaturas personalizadas, YouTube conserva la suya (Pilote avisa)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube : miniature posée après le traitement de la vidéo ; si la chaîne n'a pas le droit aux miniatures personnalisées, YouTube garde la sienne (Pilote prévient)"
          }
        }
      }
    },
    "YouTube : miniature posée une fois la vidéo traitée (l'image, sinon celle de la vidéo à l'instant choisi)." : {
