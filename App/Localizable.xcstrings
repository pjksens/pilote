    "Le trousseau du Mac demande une autorisation pour l'outil pilote : sur le Mac, lancer une fois « %@/pilote gmail-acces » et cliquer « Toujours autoriser ». Rien n'est parti." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Mac keychain is asking for permission for the pilote tool: on the Mac, run “%@/pilote gmail-acces” once and click “Always Allow”. Nothing was sent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El llavero del Mac pide autorización para la herramienta pilote: en el Mac, ejecuta una vez «%@/pilote gmail-acces» y pulsa «Permitir siempre». No se ha enviado nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le trousseau du Mac demande une autorisation pour l'outil pilote : sur le Mac, lancer une fois « %@/pilote gmail-acces » et cliquer « Toujours autoriser ». Rien n'est parti."
          }
        }
      }
    },
