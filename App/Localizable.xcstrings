    "Instagram : Pilote publie à l'heure. Le Mac doit être allumé et éveillé ; avec plus de 30 min de retard, la vidéo ne part pas et vous êtes prévenu." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instagram: Pilote posts on time. The Mac must be on and awake; if it is more than 30 min late, the video is not sent and you are notified."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instagram: Pilote publica a la hora. El Mac debe estar encendido y activo; con más de 30 min de retraso, el vídeo no sale y se te avisa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instagram : Pilote publie à l'heure. Le Mac doit être allumé et éveillé ; avec plus de 30 min de retard, la vidéo ne part pas et vous êtes prévenu."
          }
        }
      }
    },
