        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sábado, Redes propone 2 o 3 temas por franja. Tu elección valida el video al instante y llega a Redes junto con tus envíos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
